narration_lines = Array[String](["\"The door doesn't open.\", \"A voice, calm as ever, reads a number back to you. It isn't the number you expected to matter.\", \"You realize, too late, that helping was never a kindness. It was the price.\""])
final_voice_line = "\"Insufficient cooperation. This is not a punishment. This is a formality. Everything is fine.\""
