script = ExtResource("1_wmg3e")
narration_lines = Array[String](["\"You're almost at the door when the voice speaks, gently, like it's disappointed in you.\", \"It knew before you did.\", \"You think of them — whoever they were — walking beside you the whole way, and you still can't tell if they knew either.\""])
final_voice_line = "\"An anomaly was granted passage. This cannot be permitted. We are sorry. Everything is fine.\""
line_display_delay = 3.0
